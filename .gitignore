backups/
.DS_Store

# Deployable bundle machine state — never commit (portable equivalents are
# tracked; see docs/setup.md and main/codex/DEPLOY.md). Root-level .claude/
# and .codex/ are intentionally free for project-specific configuration.
main/claude/mcp_servers.json
# Machine-local Claude settings. The usual `**/.claude/settings.local.json`
# pattern stopped matching once the bundle lost its dot, so name it here.
main/claude/settings.local.json
main/codex/config.toml
main/.agents/.skill-lock.json
.agents/.skill-lock.json

# Python bytecode
__pycache__/
*.pyc

# Behavioral trap eval scratch runs (see evals/traps/)
.trap-runs/

#headroom
.tokensave
.claude/.headroom_wrap_marker.json
# Live wrap state: holder PIDs and port for the env vars wrap owns, plus its
# settings lock. Machine-local by the same rule as the marker above.
.claude/.headroom_wrap_owners.json
.claude/.headroom_wrap_settings.lock
.serena/
# s11 run artifacts: event streams are large, machine-specific, and the results
# table plus per-run .meta.json carry everything a reader needs.
evals/traps/s11-pointer-redundancy/runs/*.jsonl
evals/traps/s11-pointer-redundancy/runs/unprovenanced/
# Replay run artifacts, same reasoning one directory deeper: a run keeps its
# event stream, a workdir snapshot per turn and its own telemetry, all of which
# are large and machine-specific. meta.json is what a reader needs, and it is
# the file grade.py reads the pre-registration back out of.
evals/replay/runs/*/events.jsonl
evals/replay/runs/*/workdir/
evals/replay/runs/*/snapshots/
evals/replay/runs/*/telemetry/
evals/replay/runs/*/transcript.jsonl
evals/replay/runs/*/subagents/
# Written once by whichever grader was current when the run landed, so they go
# stale silently — one of them already carried a pre-criterion-1-gate verdict
# into a fresh batch table. `summarise.py` regrades from the run instead, and
# meta.json (the pre-registration and the conditions) is what a reader needs.
evals/replay/runs/*/verdict.json
evals/replay/runs/results.tsv
