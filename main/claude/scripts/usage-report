#!/usr/bin/env python3
"""Aggregate Claude transcript usage metadata without message content."""

from __future__ import annotations

import argparse
import json
from collections import Counter, defaultdict, deque
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path

FIELDS = (
    "input_tokens",
    "output_tokens",
    "cache_creation_input_tokens",
    "cache_read_input_tokens",
)
ATTENTION_THRESHOLDS = (30.0, 50.0, 65.0)
CURRENT_CONTEXT_WINDOWS = {
    "claude-fable-5": 1_000_000,
    "claude-opus-5": 1_000_000,
    "claude-opus-4-8": 1_000_000,
    "claude-sonnet-5": 1_000_000,
}
DEFAULT_CONTEXT_WINDOW = 200_000


@dataclass(frozen=True)
class UsageEvent:
    timestamp: datetime
    source: str
    model: str
    path: str
    usage: dict[str, int]


def parse_time(value: str) -> datetime:
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(
        timezone.utc
    )


def classify(path: Path) -> str:
    text = str(path)
    if "claude-mem-observer-sessions" in text:
        return "observer"
    if "subagents" in path.parts:
        return "subagent"
    return "main"


def load_events(root: Path, cutoff: datetime) -> list[UsageEvent]:
    events: list[UsageEvent] = []
    for path in root.rglob("*.jsonl"):
        source = classify(path)
        try:
            lines = path.open(encoding="utf-8")
        except OSError:
            continue
        with lines:
            for line in lines:
                try:
                    record = json.loads(line)
                    if record.get("type") != "assistant":
                        continue
                    message = record.get("message") or {}
                    usage = message.get("usage")
                    model = message.get("model") or "unknown"
                    if not isinstance(usage, dict) or model == "<synthetic>":
                        continue
                    timestamp = parse_time(record["timestamp"])
                except (json.JSONDecodeError, KeyError, TypeError, ValueError):
                    continue
                if timestamp < cutoff:
                    continue
                events.append(
                    UsageEvent(
                        timestamp=timestamp,
                        source=source,
                        model=model,
                        path=str(path),
                        usage={
                            field: int(usage.get(field) or 0)
                            for field in FIELDS
                        },
                    )
                )
    return sorted(events, key=lambda event: event.timestamp)


def prompt_tokens(event: UsageEvent) -> int:
    return sum(
        event.usage[field]
        for field in (
            "input_tokens",
            "cache_creation_input_tokens",
            "cache_read_input_tokens",
        )
    )


def percentile(values: list[float], quantile: float) -> float:
    if not values:
        return 0.0
    ordered = sorted(values)
    position = (len(ordered) - 1) * quantile
    lower = int(position)
    upper = min(lower + 1, len(ordered) - 1)
    fraction = position - lower
    return ordered[lower] + (ordered[upper] - ordered[lower]) * fraction


def attention_band(percent: float) -> tuple[str, str]:
    if percent >= ATTENTION_THRESHOLDS[2]:
        return (
            "compact",
            "checkpoint and compact or start a new session before critical judgment",
        )
    if percent >= ATTENTION_THRESHOLDS[1]:
        return (
            "checkpoint",
            "checkpoint before a phase change and avoid large unrelated output",
        )
    if percent >= ATTENTION_THRESHOLDS[0]:
        return ("watch", "keep context focused and checkpoint at phase boundaries")
    return ("low", "no attention-budget action")


def context_window(model: str, override: int | None = None) -> int:
    if override:
        return override
    return CURRENT_CONTEXT_WINDOWS.get(model, DEFAULT_CONTEXT_WINDOW)


def attention_summary(
    events: list[UsageEvent], override: int | None = None
) -> dict[str, dict[str, dict[str, object]]]:
    grouped: dict[tuple[str, str], list[UsageEvent]] = defaultdict(list)
    for event in events:
        grouped[(event.source, event.model)].append(event)

    report: dict[str, dict[str, dict[str, object]]] = defaultdict(dict)
    for (source, model), rows in sorted(grouped.items()):
        window = context_window(model, override)
        loads = [prompt_tokens(event) for event in rows]
        percentages = [load * 100.0 / window for load in loads]
        p50_percent = round(percentile(percentages, 0.50), 1)
        p95_percent = round(percentile(percentages, 0.95), 1)
        level, action = attention_band(p95_percent)
        report[source][model] = {
            "turns": len(rows),
            "context_window": window,
            "context_tokens_p50": round(percentile(loads, 0.50)),
            "context_tokens_p95": round(percentile(loads, 0.95)),
            "context_percent_p50": p50_percent,
            "context_percent_p95": p95_percent,
            "attention_level": level,
            "attention_action": action,
        }
    return dict(report)


def aggregate(
    events: list[UsageEvent],
) -> dict[str, dict[str, dict[str, int]]]:
    buckets: dict[tuple[str, str], Counter[str]] = defaultdict(Counter)
    sessions: dict[tuple[str, str], set[str]] = defaultdict(set)
    for event in events:
        key = (event.source, event.model)
        buckets[key].update(event.usage)
        sessions[key].add(event.path)
    report: dict[str, dict[str, dict[str, int]]] = defaultdict(dict)
    for (source, model), values in sorted(buckets.items()):
        report[source][model] = {
            "sessions": len(sessions[(source, model)]),
            "turns": sum(
                1
                for event in events
                if (event.source, event.model) == (source, model)
            ),
            **{field: values[field] for field in FIELDS},
        }
    return dict(report)


def aggregate_sessions(
    events: list[UsageEvent], override: int | None = None
) -> list[dict[str, object]]:
    sessions: dict[str, dict[str, object]] = {}
    loads: dict[str, list[int]] = defaultdict(list)
    percentages: dict[str, list[float]] = defaultdict(list)
    windows: dict[str, set[int]] = defaultdict(set)
    for event in events:
        path = Path(event.path)
        entry = sessions.setdefault(
            event.path,
            {
                "session": path.stem,
                "project": path.parent.name,
                "source": event.source,
                "turns": 0,
                "models": Counter(),
                **{field: 0 for field in FIELDS},
            },
        )
        entry["turns"] += 1
        entry["models"][event.model] += 1
        for field in FIELDS:
            entry[field] += event.usage[field]
        window = context_window(event.model, override)
        load = prompt_tokens(event)
        loads[event.path].append(load)
        percentages[event.path].append(load * 100.0 / window)
        windows[event.path].add(window)

    for path, entry in sessions.items():
        p50_percent = round(percentile(percentages[path], 0.50), 1)
        p95_percent = round(percentile(percentages[path], 0.95), 1)
        level, action = attention_band(p95_percent)
        entry["models"] = dict(entry["models"].most_common())
        entry["context_windows"] = sorted(windows[path])
        entry["context_tokens_p50"] = round(percentile(loads[path], 0.50))
        entry["context_tokens_p95"] = round(percentile(loads[path], 0.95))
        entry["context_percent_p50"] = p50_percent
        entry["context_percent_p95"] = p95_percent
        entry["attention_level"] = level
        entry["attention_action"] = action
    return sorted(
        sessions.values(),
        key=lambda row: (
            -row["context_percent_p95"],
            -row["cache_read_input_tokens"],
        ),
    )


def peak_window(
    events: list[UsageEvent], hours: float
) -> dict[str, object]:
    window: deque[UsageEvent] = deque()
    best: list[UsageEvent] = []
    span = timedelta(hours=hours)
    for event in events:
        window.append(event)
        while window and event.timestamp - window[0].timestamp > span:
            window.popleft()
        if len(window) > len(best):
            best = list(window)
    if not best:
        return {}
    models = Counter(event.model for event in best)
    sources = Counter(event.source for event in best)
    tokens: Counter[str] = Counter()
    for event in best:
        tokens.update(event.usage)
    return {
        "start": best[0].timestamp.isoformat(),
        "end": best[-1].timestamp.isoformat(),
        "turns": len(best),
        "sources": dict(sorted(sources.items())),
        "models": dict(models.most_common()),
        **{field: tokens[field] for field in FIELDS},
    }


def format_number(value: int) -> str:
    for suffix, size in (
        ("B", 1_000_000_000),
        ("M", 1_000_000),
        ("K", 1_000),
    ):
        if value >= size:
            return f"{value / size:.1f}{suffix}"
    return str(value)


def print_text(report: dict[str, object]) -> None:
    print(
        f"usage report — last {report['days']}d "
        "(assistant usage metadata only)"
    )
    print("source model sessions turns input output cache-new cache-read")
    for source, models in report["by_source_model"].items():
        for model, values in models.items():
            print(
                f"{source:9s} {model:34.34s} "
                f"{values['sessions']:8d} {values['turns']:5d} "
                f"{format_number(values['input_tokens']):>7s} "
                f"{format_number(values['output_tokens']):>7s} "
                f"{format_number(values['cache_creation_input_tokens']):>9s} "
                f"{format_number(values['cache_read_input_tokens']):>10s}"
            )
    print("attention proxy — per-turn prompt context p50/p95")
    for source, models in report["attention"].items():
        for model, values in models.items():
            print(
                f"{source:9s} {model:34.34s} "
                f"{values['context_percent_p50']:5.1f}%/"
                f"{values['context_percent_p95']:5.1f}% "
                f"{values['attention_level']:10s} "
                f"(window={format_number(values['context_window'])})"
            )
    peak = report["peak_rolling_window"]
    if peak:
        print(
            f"peak rolling {report['window_hours']:g}h by turn count: "
            f"{peak['turns']} turns"
        )
        print(f"  {peak['start']} → {peak['end']}")
        print(f"  sources={peak['sources']} models={peak['models']}")
    print(
        "note: context percentages sum uncached input, cache creation, and "
        "cache read; they are attention proxies, not subscription-quota units."
    )


def print_sessions(report: dict[str, object], top: int) -> None:
    rows = report["by_session"]
    print("top sessions by p95 context load")
    print("source session project turns p50 p95 level cache-read cache-new models")
    for row in rows[:top]:
        models = ",".join(
            f"{model}:{count}" for model, count in list(row["models"].items())[:3]
        )
        print(
            f"{row['source']:9s} {row['session'][:8]:8.8s} "
            f"{row['project'][-28:]:28.28s} {row['turns']:5d} "
            f"{row['context_percent_p50']:5.1f}% "
            f"{row['context_percent_p95']:5.1f}% "
            f"{row['attention_level']:10s} "
            f"{format_number(row['cache_read_input_tokens']):>10s} "
            f"{format_number(row['cache_creation_input_tokens']):>9s} "
            f"{models}"
        )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--days", type=float, default=7)
    parser.add_argument("--window-hours", type=float, default=5)
    parser.add_argument(
        "--root", type=Path, default=Path("~/.claude/projects").expanduser()
    )
    parser.add_argument("--now", help=argparse.SUPPRESS)
    parser.add_argument(
        "--context-window",
        type=int,
        help="override model context window for every event",
    )
    parser.add_argument(
        "--by-session",
        action="store_true",
        help="show per-session p50/p95 context load",
    )
    parser.add_argument(
        "--top", type=int, default=20, help="rows shown with --by-session"
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.context_window is not None and args.context_window <= 0:
        parser.error("--context-window must be greater than zero")

    now = parse_time(args.now) if args.now else datetime.now(timezone.utc)
    cutoff = now - timedelta(days=args.days)
    events = load_events(args.root, cutoff)
    report: dict[str, object] = {
        "generated_at": now.isoformat(),
        "days": args.days,
        "window_hours": args.window_hours,
        "by_source_model": aggregate(events),
        "attention": attention_summary(events, args.context_window),
        "attention_policy": {
            "thresholds_percent": {
                "watch": ATTENTION_THRESHOLDS[0],
                "checkpoint": ATTENTION_THRESHOLDS[1],
                "compact": ATTENTION_THRESHOLDS[2],
            },
            "model_context_windows": CURRENT_CONTEXT_WINDOWS,
            "unknown_model_context_window": DEFAULT_CONTEXT_WINDOW,
            "override": args.context_window,
        },
        "peak_rolling_window": peak_window(events, args.window_hours),
    }
    if args.by_session:
        report["by_session"] = aggregate_sessions(events, args.context_window)

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
        return
    print_text(report)
    if args.by_session:
        print_sessions(report, args.top)


if __name__ == "__main__":
    main()
