#!/usr/bin/env python3
"""Git pre-commit gate: the same green-before-commit rule, one layer lower.

`commit-test-gate.py` reads the Bash command *before* the shell runs it, so it
has to work out from text which repositories a command would commit to. Four
review rounds closed one spelling class after another there (quoting,
expansions, expanded executables, expanded targets, `~`), and the residue was
always the same shape: a program that commits with the word nowhere in the
command - a wrapper script, a shell function named `git`, a PATH shadow. No
reading of the text finds those.

This hook is on the other side of that boundary. Git runs it when a commit is
actually happening, in the repository it is actually happening in, so there is
nothing left to infer: no parsing, no target resolution, no spellings. The two
gates are complements, not alternatives - this one sees every commit in *this*
repository however it was spelled, the Bash gate sees commits the agent makes
in *any* repository before they start.

The decision itself is not duplicated: `run_suites` is imported from the Bash
gate, so the suite set, the interpreter floor, the 300 s budget and the wording
are shared. Escape hatch, deliberately the same one: `AGENT_SKIP_TEST_GATE=1`.

It carries one thing that is not a gate: on a commit that is going through, it
prints `scripts/contract-operator-delta.py` for any staged prompt-surface file.
That script exits 0 by construction and is attached here only because the hook
is the last moment a person is still looking at the change.

Where this stops, and it is not a detail: a client-side hook only runs if the
program committing lets it. `git commit --no-verify` and `git -c
core.hooksPath=/dev/null commit` both turn it off, `git commit-tree` never
consults it, and a wrapper script can carry any of those without the outer
command showing a thing - so "hidden in a wrapper" is not closed here, it is
only moved. Nothing installed on this machine closes it; the layer that does is
server-side (CI, a protected branch), which is why the enforcement chain in the
playbook does not end at pre-commit.
"""

from __future__ import annotations

import importlib.util
import os
import subprocess
import sys
from pathlib import Path


def load_gate(root: Path):
    """Import the Bash gate's machinery from this checkout, or None."""
    path = root / "main" / "claude" / "hooks" / "commit-test-gate.py"
    spec = importlib.util.spec_from_file_location("commit_test_gate", path)
    if spec is None or spec.loader is None:
        return None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def report_operator_delta(root: Path) -> None:
    """Print the staged prompt-surface operator table. Never blocks.

    `scripts/contract-operator-delta.py` is evidence a human reads, and it was
    reachable only by remembering to type it - which is the same as not having
    it, since the pass most likely to invert a connective is the one least
    likely to stop and audit itself. Attaching it here makes it arrive at the
    one moment the change is definitely about to become permanent.

    Deliberately fail-open, unlike the gate above it: the script's own contract
    is that legal operator moves vastly outnumber illegal ones, so a version of
    this that could refuse a commit would be mostly false positives, and the
    first person to hit one would remove the hook entirely. Silence when
    nothing on a prompt surface changed, for the same reason - a table printed
    on every commit is a table nobody reads.
    """
    path = root / "scripts" / "contract-operator-delta.py"
    try:
        spec = importlib.util.spec_from_file_location(
            "contract_operator_delta", path)
        if spec is None or spec.loader is None:
            return
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        reports = module.compare("HEAD", None, True)
        if not reports:
            return
        sys.stderr.write(module.render(reports, "HEAD -> index") + "\n")
    except Exception:  # noqa: BLE001 - evidence must never cost a commit
        return


def main() -> int:
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True)
    if top.returncode != 0:
        return 0  # not a work tree; let git report its own error
    root = Path(top.stdout.strip())
    if os.environ.get("AGENT_SKIP_TEST_GATE") == "1":
        # The hatch is named for the test gate and turns off exactly that. The
        # operator table refuses nothing, so there is nothing here to escape.
        report_operator_delta(root)
        return 0
    try:
        gate = load_gate(root)
    except (OSError, SyntaxError, ValueError):
        gate = None
    if gate is None:
        # Fail closed: this hook is only ever reached because a checkout asked
        # for it by pointing core.hooksPath here, so a missing gate is a broken
        # installation rather than a repository that opted out.
        sys.stderr.write(
            "pre-commit: cannot load main/claude/hooks/commit-test-gate.py - "
            "commit blocked.\n"
            "This is not a red suite: the gate this hook shares its decision with "
            "is missing from the checkout.\n"
            "Restore it, unset core.hooksPath, or commit with "
            "AGENT_SKIP_TEST_GATE=1 / --no-verify.\n"
        )
        return 1
    suites = gate.test_suites(root)
    status = (gate.run_suites([(root, tests) for tests in suites], "pre-commit")
              if suites else 0)
    if status == 0:
        # Only on the way through. A blocked commit already has one thing for
        # the operator to read, and this table would be about a state that is
        # not going to exist.
        report_operator_delta(root)
    return status


if __name__ == "__main__":
    sys.exit(main())
