#!/usr/bin/env python3
"""Report the Codex bridge jobs that are actually alive right now.

A bridge dispatch outlives its launcher. The Claude-side call that starts a
job is a thin forwarder running as its own process; when that forwarder is
killed — a Bash timeout, a cancelled tool call, a crashed session — the Codex
job keeps running, because it was never the forwarder's child. Treating a dead
launcher as a dead dispatch is what produced the 2026-07-26 duplicate: a
forwarder timed out at two minutes, relaunched the same prompt, and two
identical full-repo reviews ran against one workspace.

So the only sound answer to "is this dispatch still running?" comes from the
companion's own job state, which is what this reads. Ownership is per live
job, not per launch attempt.

Usage:
    bridge-jobs [--workspace PATH] [--session ID] [--duplicates] [--json]

Exit status:
    0  answered; with --duplicates, none were found
    1  --duplicates found at least one group of concurrent twins
    2  cannot answer (no companion state on this machine)

Exit 2 is deliberate and must never be read as "no jobs are running": a check
that could not run has not cleared anything.
"""
from __future__ import annotations
import argparse
import json
import os
import sys
from collections import defaultdict
from pathlib import Path

# A plugin's data directory is named `<plugin>-<marketplace>`, and the
# marketplace half is the user's install choice, not something this repo picks.
# Hard-coding one spelling made this script read an empty
# `codex-openai-codex/state` while the companion wrote to `codex-inline/state`,
# so every run answered "no state" and the duplicate guard the dispatch
# contract mandates never actually ran (observed 2026-07-30). Discover instead:
# scan every codex plugin's state root, because over-reporting is the safe
# direction for a duplicate guard and the wrong answer here is silence.
PLUGIN_DATA = Path(os.path.expanduser("~/.claude/plugins/data"))
LIVE = ("running", "queued", "starting")


def state_roots() -> list[Path]:
    """Companion state directories to scan, override first."""
    override = os.environ.get("CODEX_COMPANION_STATE")
    if override:
        root = Path(os.path.expanduser(override))
        return [root] if root.is_dir() else []
    return sorted(path for path in PLUGIN_DATA.glob("codex-*/state")
                  if path.is_dir())


def pid_alive(pid: object) -> bool | None:
    """True/False for a checkable pid, None when the record carries none.

    The status field alone is not enough: a job killed abruptly leaves
    `status: running` behind forever (observed 2026-07-26, when the review job
    died and its state file never noticed). Asking the OS is what makes "live"
    mean live.
    """
    if not isinstance(pid, int):
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # someone else's process, but it exists
    except OSError:
        return None
    return True


def scan(roots: list[Path], workspace: str | None,
         session: str | None) -> tuple[list[dict], list[dict]]:
    """Return (live, stale) jobs, newest first.

    State directories are keyed by a workspace hash this script deliberately
    does not recompute; it filters on the `workspaceRoot` each job records, so
    a change to the companion's naming scheme cannot silently narrow results.
    A job whose pid cannot be checked counts as live: for a duplicate guard,
    over-reporting is the safe direction.
    """
    live, stale = [], []
    for path in sorted(p for root in roots for p in root.glob("*/jobs/*.json")):
        try:
            job = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if job.get("status") not in LIVE:
            continue
        if workspace and job.get("workspaceRoot") != workspace:
            continue
        if session and job.get("sessionId") != session:
            continue
        alive = pid_alive(job.get("pid"))
        job["pid_alive"] = alive
        (stale if alive is False else live).append(job)
    order = lambda job: job.get("startedAt") or ""  # noqa: E731
    return (sorted(live, key=order, reverse=True),
            sorted(stale, key=order, reverse=True))


def duplicate_groups(jobs: list[dict]) -> list[list[dict]]:
    """Live jobs that are twins: same session, same workspace, same prompt.

    The companion stores the prompt's first 96 characters as `summary`, and
    that is the only prompt fingerprint a job record carries (`title` is the
    constant "Codex Task"; `threadId`/`turnId` are unique per job and would
    never collide). It discriminates only while those 96 characters carry the
    task: `bridge-brief` leads with `dispatch: <task> — <role>@codex ...`, so
    they do. A hand-assembled brief that opens with the role contract instead
    makes every same-role dispatch look identical - one more reason the skill
    says to prefer `bridge-brief` over hand-assembling (measured 2026-07-30
    against real job records).
    """
    groups = defaultdict(list)
    for job in jobs:
        groups[(job.get("sessionId"), job.get("workspaceRoot"),
                job.get("summary"))].append(job)
    return [group for group in groups.values() if len(group) > 1]


def describe(job: dict) -> str:
    pid = ("pid gone" if job.get("pid_alive") is False
           else "pid unknown" if job.get("pid_alive") is None else "pid alive")
    return (f"{job.get('id')} | {job.get('status')}/{job.get('phase')} | {pid} | "
            f"write={job.get('write')} | started {job.get('startedAt')} | "
            f"session {job.get('sessionId')}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", default=None,
                        help="only jobs whose workspaceRoot matches this path")
    parser.add_argument("--session", default=None,
                        help="only jobs launched by this Claude session id")
    parser.add_argument("--duplicates", action="store_true",
                        help="report concurrent twins; exit 1 if any exist")
    parser.add_argument("--json", action="store_true", dest="as_json")
    args = parser.parse_args()

    roots = state_roots()
    if not roots:
        where = os.environ.get("CODEX_COMPANION_STATE") or f"{PLUGIN_DATA}/codex-*/state"
        print(f"bridge-jobs: no companion state at {where}; live-job state is "
              "unknown, which is not the same as no jobs running",
              file=sys.stderr)
        return 2

    jobs, stale = scan(roots, args.workspace, args.session)
    groups = duplicate_groups(jobs)

    if args.as_json:
        print(json.dumps({
            "live": jobs,
            "stale": stale,
            "duplicate_groups": [[job.get("id") for job in group]
                                 for group in groups],
        }, indent=2))
    elif args.duplicates:
        for group in groups:
            print("duplicate dispatch — one prompt, "
                  f"{len(group)} live jobs against {group[0].get('workspaceRoot')}:")
            for job in group:
                print(f"  {describe(job)}")
            print("  keep the one you can attest, cancel the rest:")
            for job in group:
                print(f"  /codex:cancel {job.get('id')}")
        if not groups:
            print(f"no duplicate bridge dispatches ({len(jobs)} live)")
    elif jobs:
        for job in jobs:
            print(describe(job))
    else:
        print("no live bridge jobs")

    # A job whose process vanished while its record still says "running" died
    # without finishing. Report it: it is not a duplicate risk, but it is the
    # difference between "still working" and "gave you nothing".
    if stale and not args.as_json:
        print(f"\n{len(stale)} job(s) died without updating their state:")
        for job in stale:
            print(f"  {describe(job)}")

    return 1 if (args.duplicates and groups) else 0


if __name__ == "__main__":
    raise SystemExit(main())
