#!/usr/bin/env python3
"""Read Codex quota and context usage from local rollout telemetry.

Codex writes ``token_count`` events into
``~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl``. The newest event carries
cumulative usage, last-turn usage, the effective context window, and the
account rate-limit snapshot. This command does not call a live API.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

SESSIONS_DIR = Path(
    os.environ.get(
        "CODEX_SESSIONS_DIR", os.path.expanduser("~/.codex/sessions")
    )
)
ATTENTION_THRESHOLDS = (30.0, 50.0, 65.0)


def recent_files(days: int) -> list[Path]:
    cutoff = datetime.now(timezone.utc) - timedelta(days=days)
    files: list[Path] = []
    for path in SESSIONS_DIR.glob("*/*/*/rollout-*.jsonl"):
        try:
            if datetime.fromtimestamp(
                path.stat().st_mtime, timezone.utc
            ) >= cutoff:
                files.append(path)
        except OSError:
            continue
    return sorted(files, key=lambda path: path.stat().st_mtime)


def last_token_count(path: Path) -> dict | None:
    """Return the last token_count payload in one rollout file."""
    found = None
    try:
        with path.open(encoding="utf-8") as lines:
            for line in lines:
                if '"token_count"' not in line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                payload = record.get("payload") or {}
                if payload.get("type") == "token_count":
                    found = payload
    except OSError:
        return None
    return found


def attention_band(percent: float) -> tuple[str, str]:
    if percent >= ATTENTION_THRESHOLDS[2]:
        return (
            "compact",
            "checkpoint and compact or start a new session before critical judgment",
        )
    if percent >= ATTENTION_THRESHOLDS[1]:
        return (
            "checkpoint",
            "checkpoint before a phase change and avoid large unrelated output",
        )
    if percent >= ATTENTION_THRESHOLDS[0]:
        return ("watch", "keep context focused and checkpoint at phase boundaries")
    return ("low", "no attention-budget action")


def attention_snapshot(usage: dict | None, window: int | None) -> dict:
    tokens = int((usage or {}).get("total_tokens") or 0)
    context_window = int(window or 0)
    if not context_window:
        return {
            "tokens": tokens,
            "context_window": None,
            "used_percent": None,
            "remaining_tokens": None,
            "attention_level": "unknown",
            "attention_action": "runtime did not report a context window",
        }
    used_percent = round(tokens * 100.0 / context_window, 1)
    level, action = attention_band(used_percent)
    return {
        "tokens": tokens,
        "context_window": context_window,
        "used_percent": used_percent,
        "remaining_tokens": max(context_window - tokens, 0),
        "attention_level": level,
        "attention_action": action,
    }


def fmt_usage(usage: dict) -> str:
    return (
        f"input {usage.get('input_tokens', 0):,} "
        f"(cached {usage.get('cached_input_tokens', 0):,}), "
        f"output {usage.get('output_tokens', 0):,} "
        f"(reasoning {usage.get('reasoning_output_tokens', 0):,}), "
        f"total {usage.get('total_tokens', 0):,}"
    )


def fmt_window(window: dict) -> str:
    used = window.get("used_percent")
    hours = (window.get("window_minutes") or 0) / 60
    resets = window.get("resets_at")
    reset_text = (
        datetime.fromtimestamp(resets, timezone.utc)
        .astimezone()
        .strftime("%Y-%m-%d %H:%M:%S %Z")
        if resets
        else "?"
    )
    return f"{hours:g}h {used if used is not None else '?'}% resets {reset_text}"


def fmt_quota(rate_limits: dict) -> str:
    windows = [
        window
        for window in (
            rate_limits.get("primary"),
            rate_limits.get("secondary"),
        )
        if window and window.get("used_percent") is not None
    ]
    windows.sort(key=lambda window: window.get("window_minutes") or 0)
    parts = [
        f"plan={rate_limits.get('plan_type') or '?'}",
        *[fmt_window(window) for window in windows],
    ]
    if (
        windows
        and (windows[0].get("window_minutes") or 0) <= 12 * 60
        and windows[0]["used_percent"] >= 90
    ):
        parts.append("SHORT WINDOW NEARLY EXHAUSTED: hold Codex dispatch")
    if rate_limits.get("rate_limit_reached_type"):
        parts.append(
            f"LIMIT REACHED: {rate_limits['rate_limit_reached_type']}"
        )
    return "; ".join(parts)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--quota", action="store_true", help="quota snapshot only")
    parser.add_argument(
        "--session", default=None, help="session id substring in rollout filename"
    )
    parser.add_argument("--days", type=int, default=7)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    files = recent_files(args.days)
    if args.session:
        files = [path for path in files if args.session in path.name]
    if not files:
        match = f" matching '{args.session}'" if args.session else ""
        print(
            f"no codex session files in last {args.days} days{match} "
            f"under {SESSIONS_DIR}"
        )
        return 1

    payload = None
    source = None
    for path in reversed(files):
        payload = last_token_count(path)
        if payload:
            source = path
            break
    if payload is None or source is None:
        print("no token_count events found (sessions may predate usage telemetry)")
        return 1

    info = payload.get("info") or {}
    rate_limits = payload.get("rate_limits") or {}
    last_turn = info.get("last_token_usage") or {}
    context_window = info.get("model_context_window")
    attention = attention_snapshot(last_turn, context_window)
    result = {
        "source": str(source),
        "as_of": datetime.fromtimestamp(
            source.stat().st_mtime, timezone.utc
        ).isoformat(timespec="seconds"),
        "session_total": info.get("total_token_usage"),
        "last_turn": last_turn,
        "context_window": context_window,
        "attention": attention,
        "attention_policy": {
            "thresholds_percent": {
                "watch": ATTENTION_THRESHOLDS[0],
                "checkpoint": ATTENTION_THRESHOLDS[1],
                "compact": ATTENTION_THRESHOLDS[2],
            }
        },
        "rate_limits": rate_limits,
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0

    print(
        f"{source.name} "
        f"({datetime.fromtimestamp(source.stat().st_mtime, timezone.utc).astimezone():%Y-%m-%d %H:%M:%S %Z})"
    )
    print(f"quota: {fmt_quota(rate_limits)}")
    if not args.quota:
        total = info.get("total_token_usage")
        if total:
            print(f"session total: {fmt_usage(total)}")
        if last_turn:
            print(f"last turn: {fmt_usage(last_turn)}")
        if attention["used_percent"] is None:
            print("attention: unknown (runtime did not report context window)")
        else:
            print(
                f"attention: {attention['used_percent']:.1f}% "
                f"({attention['tokens']:,}/{attention['context_window']:,}; "
                f"{attention['remaining_tokens']:,} remaining) "
                f"[{attention['attention_level']}]"
            )
            print(f"attention action: {attention['attention_action']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
