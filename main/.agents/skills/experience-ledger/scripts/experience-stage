#!/usr/bin/env python3
"""Stage the launch and completion of a native Codex dispatch.

Claude Code stages these stubs from its SubagentStart/SubagentStop hooks
(`experience-pending.py`). Native Codex has no such hook, so a dispatch there
had no carrier at all: nothing recorded that it was launched, and
`weekly-integrity` — which finds forgotten outcomes by looking for a staged
completion the ledger never answered — had nothing to look for. A native Codex
outcome that never reached the ledger was therefore invisible, and the missing
records are not random: a hard or failed dispatch is the one a session is most
likely to abandon, which biases every cohort the ledger feeds back into routing.

This is that carrier, written by the dispatcher instead of a hook:

    experience-stage --start --role executor            # prints the dispatch id
    experience-stage --stop --dispatch-id <id>          # records wall-clock secs
    experience-log --from-pending --dispatch-id <id> --outcome accepted ...

A launch that never ran (cancelled before the leaf started) is retired with
`--cancel`; anything that did run is logged, `failed` included. Staged rows
live in the same pending file as the hook's (override:
AGENT_EXPERIENCE_PENDING) and are consumed by the same `experience-log` paths.

Both of those rules are enforced here rather than left to the dispatcher
(2026-07-30 review), because the pending file is the only thing weekly
reconciliation can look at:

* `--cancel` refuses a dispatch that already has a staged completion. Deleting
  a launch *and* its completion is exactly how a dispatch that ran leaves no
  carrier behind, and the hard and failed ones are the likeliest to be
  abandoned that way — the success bias this script exists to prevent.
* A dispatch id is unique against the ledger as well as the pending file.
  Clearing the stub on log frees the id in the pending file, but
  `weekly-integrity` skips any id the ledger already names, so a reused id is
  permanently immune to the un-reconciled alarm — a second silent-omission
  channel of the same class.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import uuid
from contextlib import contextmanager
from datetime import datetime, timezone

# Same loggable roles as experience-log; a stub whose role it would not accept
# is a stub nothing can reconcile.
ROLES = (
    "explore", "mech-executor", "executor",
    "plan-verifier", "verifier", "security-reviewer", "security-executor",
)
# Native Codex only. The bridge and native Claude both have hooks, and a
# hand-written stub racing a hook-written one is a reconciliation problem, not
# a carrier.
REQUEST_SOURCE = "codex"

PENDING_PATH = os.environ.get(
    "AGENT_EXPERIENCE_PENDING",
    os.path.expanduser("~/.agents/telemetry/experience-pending.jsonl"),
)
LEDGER_PATH = os.environ.get(
    "AGENT_EXPERIENCE_LEDGER",
    os.path.expanduser("~/.agents/telemetry/experience.jsonl"),
)

try:
    import fcntl
except ImportError:  # pragma: no cover - non-POSIX fallback keeps staging usable
    fcntl = None


@contextmanager
def pending_lock():
    """Serialize with the hook's appends and experience-log's rewrites."""
    os.makedirs(os.path.dirname(PENDING_PATH), exist_ok=True)
    with open(PENDING_PATH + ".lock", "a", encoding="utf-8") as lock:
        if fcntl is not None:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            if fcntl is not None:
                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def read_pending() -> list[dict]:
    try:
        with open(PENDING_PATH, encoding="utf-8") as stream:
            return [json.loads(line) for line in stream if line.strip()]
    except FileNotFoundError:
        return []


def write_pending(rows: list[dict]) -> None:
    with open(PENDING_PATH, "w", encoding="utf-8") as stream:
        for row in rows:
            stream.write(json.dumps(row) + "\n")


def append_pending(row: dict) -> None:
    with open(PENDING_PATH, "a", encoding="utf-8") as stream:
        stream.write(json.dumps(row) + "\n")


def ledger_dispatch_ids() -> set[str]:
    """Dispatch ids the ledger already answers for.

    A malformed line is skipped rather than fatal: this is a uniqueness check
    over machine-local telemetry, and refusing to stage a launch because an
    unrelated row is corrupt would push the dispatcher into staging nothing.
    `errors="replace"` extends that to a corrupt byte: decoding runs before
    json.loads, so a half-written multi-byte character used to raise
    UnicodeDecodeError and block staging outright (2026-07-30 re-review).
    """
    ids: set[str] = set()
    try:
        with open(LEDGER_PATH, encoding="utf-8", errors="replace") as stream:
            for raw in stream:
                if not raw.strip():
                    continue
                try:
                    record = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                dispatch_id = isinstance(record, dict) and record.get("dispatch_id")
                if isinstance(dispatch_id, str) and dispatch_id:
                    ids.add(dispatch_id)
    except OSError:
        return ids
    return ids


def split_dispatch_id(dispatch_id: str, session: str | None) -> tuple[str, str]:
    """Recover the `<session>:<agent>` halves the pending file pairs stubs by."""
    head, separator, tail = dispatch_id.rpartition(":")
    if separator and head and tail:
        return head, tail
    return (session or REQUEST_SOURCE), dispatch_id


def stage_start(args, parser) -> int:
    session = args.session or os.environ.get("CODEX_SESSION_ID") or REQUEST_SOURCE
    dispatch_id = args.dispatch_id or f"{session}:{uuid.uuid4().hex[:8]}"
    session_id, agent_id = split_dispatch_id(dispatch_id, session)
    with pending_lock():
        if any(row.get("dispatch_id") == dispatch_id for row in read_pending()):
            parser.error(
                f"{dispatch_id} is already staged; finish it with --stop and "
                "experience-log, or retire it with --cancel. Reusing a dispatch "
                "id would file two dispatches under one outcome"
            )
        # Logging clears the stub, so the pending file alone stops recognising
        # an id the moment it is reconciled. The ledger keeps it forever, and
        # `weekly-integrity` skips every id the ledger names — a reused id
        # would therefore never be reported as un-reconciled again.
        if dispatch_id in ledger_dispatch_ids():
            parser.error(
                f"{dispatch_id} is already in the ledger; pick a new id. "
                "Reusing a logged id files a second dispatch under the first "
                "one's outcome, and reconciliation skips every id the ledger "
                "already names, so the second one could never be reported"
            )
        append_pending({
            "ts": args.now or datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "event": "SubagentStart",
            "agent_type": args.role,
            "agent_id": agent_id,
            "session_id": session_id,
            "dispatch_id": dispatch_id,
            "request_source": REQUEST_SOURCE,
        })
    print(dispatch_id)
    return 0


def stage_stop(args, parser) -> int:
    now = datetime.now(timezone.utc)
    with pending_lock():
        rows = read_pending()
        start = next(
            (row for row in reversed(rows)
             if row.get("event") == "SubagentStart"
             and row.get("dispatch_id") == args.dispatch_id),
            None,
        )
        if start is None:
            parser.error(
                f"no staged launch for {args.dispatch_id}; stage it with "
                "--start at launch time (a completion with no launch has no "
                "wall-clock to report and no launch to reconcile)"
            )
        if any(row.get("event") == "SubagentStop"
               and row.get("dispatch_id") == args.dispatch_id for row in rows):
            parser.error(
                f"{args.dispatch_id} already has a staged completion; log its "
                "outcome with experience-log --from-pending --dispatch-id "
                f"{args.dispatch_id}"
            )
        stop = {
            "ts": args.now or now.isoformat(timespec="seconds"),
            "event": "SubagentStop",
            "agent_type": start.get("agent_type"),
            "agent_id": start.get("agent_id"),
            "session_id": start.get("session_id"),
            "dispatch_id": args.dispatch_id,
            "request_source": REQUEST_SOURCE,
        }
        try:
            started = datetime.fromisoformat(start["ts"])
            stop["secs"] = round((now - started).total_seconds(), 1)
        except (KeyError, ValueError, TypeError):
            pass
        append_pending(stop)
    print(f"staged completion: {args.dispatch_id}")
    return 0


def stage_cancel(args, parser) -> int:
    """Retire a launch whose leaf never ran — and only such a launch.

    `--cancel` is the one operation that removes a carrier without producing a
    record, so it is the one operation that can make a dispatch invisible. A
    staged completion is proof the leaf ran, and something that ran is logged,
    `failed` included; a ledger record means the id is spoken for either way.
    Refusing both leaves exactly the contract's case: launched, never ran.
    """
    with pending_lock():
        rows = read_pending()
        matching = [row for row in rows if row.get("dispatch_id") == args.dispatch_id]
        if not matching:
            parser.error(f"nothing staged for {args.dispatch_id}")
        if any(row.get("event") == "SubagentStop" for row in matching):
            parser.error(
                f"{args.dispatch_id} has a staged completion, so its leaf ran; "
                "--cancel only retires a launch that never ran. Log the outcome "
                "instead (experience-log --from-pending --dispatch-id "
                f"{args.dispatch_id} --outcome failed ... is the right call for "
                "a dispatch that ran and produced nothing usable)"
            )
        if args.dispatch_id in ledger_dispatch_ids():
            parser.error(
                f"{args.dispatch_id} is already in the ledger; its outcome is "
                "recorded and there is nothing to retire"
            )
        keep = [row for row in rows if row.get("dispatch_id") != args.dispatch_id]
        write_pending(keep)
    print(f"cancelled: {args.dispatch_id}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--start", action="store_true",
                      help="stage a launch and print its dispatch id")
    mode.add_argument("--stop", action="store_true",
                      help="stage the completion of a staged launch")
    mode.add_argument("--cancel", action="store_true",
                      help="retire a launch whose leaf never ran; anything that "
                           "ran is logged instead, `failed` included")
    parser.add_argument("--role", choices=ROLES, default=None)
    parser.add_argument("--dispatch-id", default=None,
                        help="stable id shared by [LEAF_DISPATCH], [LEAF_RESULT], "
                             "and the ledger record")
    parser.add_argument("--session", default=None,
                        help="session label for a generated dispatch id")
    parser.add_argument("--now", default=None, help="ISO timestamp override (tests)")
    args = parser.parse_args()

    if args.start and args.role is None:
        parser.error("--start requires --role")
    if (args.stop or args.cancel) and not args.dispatch_id:
        parser.error("--stop and --cancel require --dispatch-id")
    if args.start:
        return stage_start(args, parser)
    if args.stop:
        return stage_stop(args, parser)
    return stage_cancel(args, parser)


if __name__ == "__main__":
    sys.exit(main())
