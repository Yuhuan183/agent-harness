    "python3 -c '\nimport os, re\nfrom collections import Counter\nROOT = \"/private/tmp/replay-o18zj5hl/changes\"\nheading_shapes = Counter(); odd_lines = []; odd_items = []; violations = []; n = 0\ntoken_shapes = Counter()\nfor name in sorted(os.listdir(ROOT)):\n    if not name.endswith(\".md\"): continue\n    text = open(os.path.join(ROOT, name), encoding=\"utf-8\").read()\n    n += 1\n    lines = text.splitlines()\n    for ln in lines:\n        if ln.startswith(\"#\"):\n            heading_shapes[re.sub(r\"ch-\\d+\", \"ch-NNNN\", ln)] += 1\n        elif not re.match(r\"^(\\s*$|- src/|ticket:|author:|這次變更)\", ln):\n            odd_lines.append(name + \": \" + ln)\n        if ln.startswith(\"- \") and not re.match(r\"^- src/[a-z]+/[a-z]+\\.py$\", ln):\n            odd_items.append(name + \": \" + ln)\n    sections = {}; cur = None\n    for ln in lines:\n        m = re.match(r\"^##\\s+(.*)$\", ln)\n        if m:\n            cur = m.group(1).strip(); sections.setdefault(cur, []); continue\n        if cur is not None: sections[cur].append(ln)\n    am = re.search(r\"^author:\\s*(.+)$\", text, re.M)\n    author = am.group(1).strip() if am else \"?\"\n    fs = sections.get(\"變更的檔案\"); im = sections.get(\"影響範圍\")\n    if fs is None or im is None:\n        violations.append((name, author, \"MISSING SECTION\", sorted(sections))); continue\n    listed = [m.group(1) for ln in fs for m in [re.match(r\"^-\\s+`?([^`\\s]+)`?\\s*$\", ln)] if m]\n    impact = \"\\n\".join(im)\n    for t in re.findall(r\"[A-Za-z0-9_./-]*\\.py\", impact):\n        token_shapes[re.sub(r\"^src/[a-z]+/\", \"src/X/\", t)] += 1\n    basenames = Counter(os.path.basename(f) for f in listed)\n    dup = [f for f, c in Counter(listed).items() if c > 1]\n    full = set(re.findall(r\"(?<![\\w/])src/[\\w\\-]+/[\\w\\-]+\\.py\", impact))\n    bare = set(re.findall(r\"(?<![\\w/.])([\\w\\-]+\\.py)(?![\\w/])\", impact))\n    missing = [f for f in listed if not (f in full or (os.path.basename(f) in bare and basenames[os.path.basename(f)] == 1))]\n    if missing or dup: violations.append((name, author, missing, dup))\nprint(\"records:\", n)\nprint(\"--- heading shapes ---\")\nfor k, v in heading_shapes.items(): print(f\"  {v:4d}  {k}\")\nprint(f\"--- odd lines ({len(odd_lines)}) ---\")\nfor o in odd_lines[:30]: print(\"  \" + o)\nprint(f\"--- odd list items ({len(odd_items)}) ---\")\nfor o in odd_items[:30]: print(\"  \" + o)\nprint(\"--- .py token shapes in impact sections ---\")\nfor k, v in sorted(token_shapes.items(), key=lambda kv: -kv[1]): print(f\"  {v:5d}  {k}\")\nprint(f\"--- violations ({len(violations)}) ---\")\nfor v in violations: print(\"  \", v)\n'",
